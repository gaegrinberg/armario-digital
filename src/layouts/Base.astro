---
import '../styles/global.css';
import { CONFIG } from '../config';
import { todasAsCamisas } from '../lib/camisas';
import { link } from '../lib/link';

interface Props {
  titulo?: string;
  descricao?: string;
  atual?: 'arara' | 'grade' | 'mapa' | 'numeros' | 'desejos';
}
const { titulo, descricao = 'Coleção pessoal de camisas de futebol.', atual } = Astro.props;
const exemplos = (await todasAsCamisas()).some((c) => c.tags.includes('exemplo'));

// Seções da barra de navegação. Os ícones são traços de 24 px no vocabulário da arara;
// o que tem a classe "preench" ganha um fundo leve na seção atual.
const SECOES = [
  { id: 'arara', nome: 'Arara', href: '', icone: '<path d="M10 6.2a2 2 0 1 1 2.9 1.8c-.6.3-.9.8-.9 1.4V10"/><path class="preench" d="M12 10 3.6 16.6a.9.9 0 0 0 .6 1.6h15.6a.9.9 0 0 0 .6-1.6Z"/>' },
  { id: 'grade', nome: 'Grade', href: 'grade/', icone: '<rect class="preench" x="4" y="4" width="7" height="7" rx="1.5"/><rect class="preench" x="13" y="4" width="7" height="7" rx="1.5"/><rect class="preench" x="4" y="13" width="7" height="7" rx="1.5"/><rect class="preench" x="13" y="13" width="7" height="7" rx="1.5"/>' },
  { id: 'mapa', nome: 'Mapa', href: 'mapa/', icone: '<path class="preench" d="M12 21s-6.5-5.7-6.5-11a6.5 6.5 0 0 1 13 0c0 5.3-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>' },
  { id: 'numeros', nome: 'Números', href: 'numeros/', icone: '<rect class="preench" x="3" y="5" width="18" height="14" rx="2.5"/><path d="M12 5v14M7.5 10v4M15.5 10h2v2h-2v2h2"/>' },
  { id: 'desejos', nome: 'Desejos', href: 'desejos/', icone: '<path class="preench" d="M3.5 12.2V4.5a1 1 0 0 1 1-1h7.7l8.3 8.3a1 1 0 0 1 0 1.4l-7.3 7.3a1 1 0 0 1-1.4 0Z"/><circle cx="8" cy="8" r="1.6"/>' },
] as const;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{titulo ? `${titulo} · ${CONFIG.titulo}` : CONFIG.titulo}</title>
  <meta name="description" content={descricao} />
  <link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
  <!-- Instalar como app: manifesto (Android e computador) e ícone do iPhone -->
  <link rel="manifest" href={link('manifest.webmanifest')} />
  <link rel="apple-touch-icon" href={link('apple-touch-icon.png')} />
  <meta name="apple-mobile-web-app-title" content="Armário" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="theme-color" content="#EDEBE6" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#121315" media="(prefers-color-scheme: dark)" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&family=Archivo:wght@400;500;600&family=Londrina+Solid:wght@900&display=swap"
    rel="stylesheet"
  />
  <!-- Aplica o tema salvo antes de desenhar a página, para não piscar -->
  <script is:inline>
    try { const t = localStorage.getItem('tema'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <div class="pagina">
    <header class="barra">
      {/* Na arara o título grande já faz esse papel */}
      {atual === 'arara' ? <span /> : <a class="marca" href={link('')}>{CONFIG.titulo}</a>}
      {/* No celular vira a barra fixa embaixo; no computador, o controle segmentado do topo */}
      <nav class="nav" aria-label="Seções">
        {SECOES.map((s) => (
          <a class="aba" href={link(s.href)} aria-current={atual === s.id ? 'page' : undefined}>
            {atual === s.id && <span class="aba-marcador" />}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icone} />
            <span class="aba-nome">{s.nome}</span>
          </a>
        ))}
      </nav>
      <button class="pilula" id="tema" type="button">◐ Auto</button>
    </header>
    <slot />
    <footer class="rodape">
      {exemplos && <p>Algumas camisas são exemplos com dados fictícios: clubes reais, mas fabricantes, patrocinadores e histórias inventados.</p>}
      <p>Fotos do acervo pessoal. Silhuetas genéricas, sem escudos ou marcas.</p>
      <p><a class="link-admin" href={link('admin/')} rel="nofollow">Cadastrar ou editar camisas</a></p>
    </footer>
  </div>
  <script>
    const TEMAS = [
      { valor: 'auto', rotulo: 'Auto', nome: 'automático' },
      { valor: 'light', rotulo: 'Claro', nome: 'claro' },
      { valor: 'dark', rotulo: 'Escuro', nome: 'escuro' },
    ];
    const botao = document.getElementById('tema')!;
    let atual = 'auto';
    try { atual = localStorage.getItem('tema') || 'auto'; } catch {}
    const aplicar = (valor: string) => {
      if (valor === 'auto') delete document.documentElement.dataset.theme;
      else document.documentElement.dataset.theme = valor;
      const tema = TEMAS.find((t) => t.valor === valor) ?? TEMAS[0];
      botao.textContent = '◐ ' + tema.rotulo;
      botao.setAttribute('aria-label', `Tema: ${tema.nome}. Toque para trocar.`);
      try { localStorage.setItem('tema', valor); } catch {}
    };
    aplicar(atual);
    botao.addEventListener('click', () => {
      const i = TEMAS.findIndex((t) => t.valor === atual);
      atual = TEMAS[(i + 1) % TEMAS.length].valor;
      aplicar(atual);
    });
  </script>
</body>
</html>
