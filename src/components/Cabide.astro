---
// Uma camisa pendurada na arara: gancho, camisa e etiqueta de papel.
// Camisa da lista de desejos vira cabide vazio com etiqueta "procura-se".
import FotoCamisa from './FotoCamisa.astro';
import { tipoCurto, type Camisa } from '../lib/camisas';
import { link } from '../lib/link';

interface Props {
  camisa: Camisa;
  prioridade?: boolean;
}
const { camisa: c, prioridade } = Astro.props;
const vazio = c.status === 'desejo';
---
<a
  class:list={['cabide', { vazio }]}
  href={link(`camisa/${c.id}/`)}
  data-busca={c.busca}
  data-status={c.status}
  aria-label={`${c.clube.nome} ${c.temporada}, ${tipoCurto(c)}${vazio ? ', lista de desejos' : ''}`}
>
  <div class="pendurado">
    <svg class="gancho" viewBox="0 0 100 44" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M50 26 V18 C50 14 58 13 58 7 C58 2 50 0 46 4" />
      <path d="M50 26 L8 42 H92 Z" />
    </svg>
    <div class="camisa">
      <FotoCamisa camisa={c} tamanho="miniatura" rotulo={false} prioridade={prioridade} />
    </div>
    <span class="etiqueta">
      {c.clube.uf && <span class="uf-tag">{c.clube.uf}</span>}
      {vazio && <span class="procura">Procura-se</span>}
      <strong>{c.clube.nome}</strong>
      <span class="meta">{c.temporada} · {tipoCurto(c)}</span>
    </span>
  </div>
</a>

<style>
  .cabide {
    position: relative; flex: none; width: 42vw; max-width: 210px;
    scroll-snap-align: start; text-align: center; color: inherit; text-decoration: none;
  }
  @media (min-width: 760px) { .cabide { width: 190px; } }
  :global(.grande) .cabide { width: 56vw; max-width: 270px; }
  @media (min-width: 760px) { :global(.grande) .cabide { width: 250px; } }

  /* Tudo que está pendurado gira junto, a partir do gancho */
  .pendurado {
    --giro: 0deg;
    transform-origin: 50% 6px; transform: rotate(calc(var(--balanco, 0deg) + var(--giro)));
    transition: transform 0.9s cubic-bezier(0.25, 1.8, 0.45, 1);
  }
  :global(.trilho.rolando) .pendurado { transition-duration: 0.25s; }
  .cabide:hover .pendurado, .cabide:focus-visible .pendurado { --giro: -2.5deg; }
  .gancho { display: block; width: 44%; margin: 0 auto; color: var(--metal); }
  .camisa { margin-top: -15%; padding: 0 5%; }
  .camisa :global(.silhueta) { aspect-ratio: 1 / 0.92; filter: var(--sombra-camisa); }
  /* Foto recortada: mesma caixa da silhueta, com a gola encaixada no cabide */
  .camisa :global(.foto-recorte) { aspect-ratio: 1 / 1.05; object-fit: contain; object-position: top; }
  .camisa :global(.foto-placa) { margin-top: 15%; }

  .cabide:nth-child(even) .etiqueta { --torto: 2.5deg; }
  .cabide:nth-child(3n) .etiqueta { --torto: -0.5deg; }

  .vazio .camisa :global(.silhueta) { opacity: 0.2; filter: grayscale(1); }
  .vazio .camisa :global(img) { opacity: 0.25; filter: grayscale(1); }
  .vazio .etiqueta { background: transparent; border-style: dashed; border-color: var(--texto-2); box-shadow: none; }

  @media (prefers-reduced-motion: reduce) {
    .pendurado { transition: none; transform: none; }
  }
</style>
